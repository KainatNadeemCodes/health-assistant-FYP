# Backend Environment Configuration
PORT=8000
HOST=0.0.0.0

# Security & JWT Configuration
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_SECRET=change-this-admin-password-in-production

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database & Model Paths (Optional overrides)
# DATABASE_PATH=/path/to/health_assistant.db
# MODEL_PATH=/path/to/model.pkl
# VECTORIZER_PATH=/path/to/vectorizer.pkl
# FFMPEG_PATH=/usr/bin/ffmpeg
